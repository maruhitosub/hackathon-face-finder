{
  "name": "hackathon-face-finder",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix web run build",
    "dev": "npm run build && wrangler dev",
    "seed:local": "node scripts/seed-local.mjs",
    "models": "node scripts/fetch-models.mjs",
    "typecheck": "tsc -p worker && npm --prefix web exec tsc",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "wrangler": "^4.162.0"
  }
}
