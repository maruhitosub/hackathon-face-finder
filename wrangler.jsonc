{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jisaku",
  "account_id": "5191b613f9bb6f30cb05a83e66d41a72", // Tompedia_Labo
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-16",
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "facefinder.tohoku.app", "custom_domain": true }],

  // web/dist は静的配信。API と写真だけ Worker を通す
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/img/*", "/dl/*"]
  },

  // 写真と索引（非公開）
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "hackathon-photos" }],

  // ログインは IP ごとに 1 分 10 回まで
  "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],

  "vars": {
    "SESSION_DAYS": "7"
  }
  // シークレット: SITE_PASSWORD, SESSION_SECRET（ローカルは .dev.vars）
}
